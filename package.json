{
  "name": "write-judge",
    "type": "module",
  "description": "Pi extension: a small yes/no model blocks edits that weaken tests, before they land.",
  "version": "0.2.0",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "ai-agents", "testing", "cloudflare", "workers-ai"],
  "repository": "github:acoyfellow/write-judge",
  "files": ["src", "defaults.json", "README.md", "LICENSE"],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^22.0.0",
    "oxlint": "1.88.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "typebox": "1.3.27"
  }
}
